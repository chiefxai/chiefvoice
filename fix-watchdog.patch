+class GeminiResponseObserver(FrameProcessor):
+    """Observe Gemini output downstream of the model and update its watchdog."""
+
+    def __init__(self, watchdog: GeminiConversationWatchdog) -> None:
+        super().__init__()
+        self._watchdog = watchdog
+
+    async def process_frame(self, frame: Any, direction: FrameDirection) -> None:
+        await super().process_frame(frame, direction)
+        if direction is FrameDirection.DOWNSTREAM:
+            if isinstance(frame, LLMFullResponseStartFrame):
+                self._watchdog.on_gemini_response_started()
+            elif isinstance(frame, OutputAudioRawFrame):
+                self._watchdog.on_gemini_audio()
+            elif isinstance(frame, LLMFullResponseEndFrame):
+                self._watchdog.on_gemini_response_finished()
+        await self.push_frame(frame, direction)
