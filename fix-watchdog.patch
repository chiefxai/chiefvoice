+"""Regression tests for Gemini response watchdog and caller idle separation."""
+
+from __future__ import annotations
+
+import asyncio
+from types import SimpleNamespace
+
+import pytest
+from pipecat.frames.frames import (
+    LLMFullResponseEndFrame,
+    LLMFullResponseStartFrame,
+    OutputAudioRawFrame,
+    TranscriptionFrame,
+    UserStartedSpeakingFrame,
+    UserStoppedSpeakingFrame,
+)
+from pipecat.processors.frame_processor import FrameDirection
+
+from chiefvoice.agents.call.conversation_reliability import (
+    GeminiConversationWatchdog,
+    GeminiResponseObserver,
+)
+
+
+class Diagnostics:
+    def __init__(self):
+        self.events: dict[str, int] = {}
+
+    def record_conversation_event(self, key):
+        self.events[key] = self.events.get(key, 0) + 1
+
+
+class Service:
+    def __init__(self):
+        self._session = object()
+        self._ready_for_realtime_input = True
+        self._bot_is_responding = False
+        self._disconnecting = False
+        self.recoveries = 0
+        self.hangups = 0
+        self.on_recovery = None
+
+    async def recover_unanswered_turn(self):
+        self.recoveries += 1
+        if self.on_recovery is not None:
+            await self.on_recovery()
+        return True
+
+    async def play_fallback_and_hangup(self):
+        self.hangups += 1
+        raise AssertionError("Response watchdog must never end calls")
+
+
+async def make_watchdog(*, response_timeout=0.01, recovery_grace=0.01, inactivity=0.01):
+    service = Service()
+    diagnostics = Diagnostics()
+    watchdog = GeminiConversationWatchdog(
+        SimpleNamespace(session_id="call-id", provider="vobiz"),
+        service,
+        diagnostics,
+        response_timeout_seconds=response_timeout,
+        recovery_grace_seconds=recovery_grace,
+        caller_inactivity_seconds=inactivity,
+        max_recovery_attempts=2,
+    )
+
+    async def discard(*_args):
+        return None
+
+    watchdog.push_frame = discard
+    observer = GeminiResponseObserver(watchdog)
+    observer.push_frame = discard
+    return watchdog, observer, service, diagnostics
+
+
+@pytest.mark.asyncio
+async def test_watchdog_does_not_arm_during_speech_or_on_partial_transcription():
+    watchdog, _, service, diagnostics = await make_watchdog()
+    try:
+        await watchdog.process_frame(UserStartedSpeakingFrame(), FrameDirection.DOWNSTREAM)
+        await watchdog.process_frame(
+            TranscriptionFrame(text="still speaking", user_id="caller"),
+            FrameDirection.UPSTREAM,
+        )
+        await asyncio.sleep(0.025)
+        assert service.recoveries == 0
+        assert watchdog._watch_task is None
+        assert diagnostics.events["caller_speech_started"] == 1
+        await watchdog.process_frame(UserStoppedSpeakingFrame(), FrameDirection.DOWNSTREAM)
+        await asyncio.sleep(0.025)
+        assert diagnostics.events["response_watchdog_fired"] == 1
+        assert service.recoveries >= 1
+    finally:
+        await watchdog.cleanup()
+
+
+@pytest.mark.asyncio
+async def test_response_start_cancels_pending_watchdog_from_other_side_of_model():
+    watchdog, observer, service, diagnostics = await make_watchdog(response_timeout=0.025)
+    try:
+        await watchdog.process_frame(UserStartedSpeakingFrame(), FrameDirection.DOWNSTREAM)
+        await watchdog.process_frame(UserStoppedSpeakingFrame(), FrameDirection.DOWNSTREAM)
+        assert watchdog._watch_task is not None
+        await observer.process_frame(LLMFullResponseStartFrame(), FrameDirection.DOWNSTREAM)
+        await asyncio.sleep(0.04)
+        assert service.recoveries == 0
+        assert watchdog._gemini_generating is True
+        assert diagnostics.events["response_watchdog_cancelled"] >= 1
+    finally:
+        await watchdog.cleanup()
+
+
+@pytest.mark.asyncio
+async def test_audio_without_start_frame_also_cancels_watchdog():
+    watchdog, observer, service, _ = await make_watchdog(response_timeout=0.025)
+    try:
+        await watchdog.process_frame(UserStartedSpeakingFrame(), FrameDirection.DOWNSTREAM)
+        await watchdog.process_frame(UserStoppedSpeakingFrame(), FrameDirection.DOWNSTREAM)
+        await observer.process_frame(
+            OutputAudioRawFrame(audio=b"ab", sample_rate=24000, num_channels=1),
+            FrameDirection.DOWNSTREAM,
+        )
+        await asyncio.sleep(0.04)
+        assert service.recoveries == 0
+        assert watchdog._response_audio_seen is True
+    finally:
+        await watchdog.cleanup()
+
+
+@pytest.mark.asyncio
+async def test_stale_turn_and_new_caller_speech_never_recover():
+    watchdog, _, service, _ = await make_watchdog(response_timeout=0.03)
+    try:
+        await watchdog.process_frame(UserStartedSpeakingFrame(), FrameDirection.DOWNSTREAM)
+        await watchdog.process_frame(UserStoppedSpeakingFrame(), FrameDirection.DOWNSTREAM)
+        expired_turn = watchdog._turn
+        await watchdog.process_frame(UserStartedSpeakingFrame(), FrameDirection.DOWNSTREAM)
+        await watchdog._watch_turn(expired_turn, "old_caller_turn")
+        await asyncio.sleep(0.04)
+        assert service.recoveries == 0
+    finally:
+        await watchdog.cleanup()
+
+
+@pytest.mark.asyncio
+async def test_unready_or_generating_service_never_recovers():
+    watchdog, _, service, diagnostics = await make_watchdog()
+    try:
+        service._ready_for_realtime_input = False
+        await watchdog.process_frame(UserStartedSpeakingFrame(), FrameDirection.DOWNSTREAM)
+        await watchdog.process_frame(UserStoppedSpeakingFrame(), FrameDirection.DOWNSTREAM)
+        await asyncio.sleep(0.025)
+        assert diagnostics.events["response_watchdog_not_ready"] == 1
