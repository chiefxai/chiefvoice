APP_ENV=local
OBJECT_STORAGE_PROVIDER=s3
LOG_LEVEL=INFO
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_SESSION_TOKEN=
OBJECT_STORAGE_ADDRESSING_STYLE=path
OBJECT_STORAGE_PREFIX=chiefvoice
RECORDINGS_ENABLED=false
RECORDINGS_STORAGE_BACKEND=local
RECORDINGS_DIR=./var/recordings
RECORDINGS_ENCRYPTION_KEY=
RECORDINGS_ALLOW_UNENCRYPTED_LOCAL=true
RETENTION_INTERVAL_SECONDS=3600
RETENTION_POLICIES_JSON=[]
BACKUP_DIRECTORY=./var/backups
BACKUP_STORAGE_BACKEND=local
BACKUP_ENCRYPTION_KEY=
BACKUP_POLICIES_JSON=[]
BACKUP_INTERVAL_SECONDS=3600
BACKUP_RESTORE_TARGETS_JSON=[]
OTEL_SERVICE_NAME=chiefvoice-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_TENANT_CLAIM=tenant_id
OIDC_ALGORITHMS=RS256
DATABASE_URL=postgresql+asyncpg://chiefvoice:change-me@localhost:5432/chiefvoice
CREDENTIALS_ENCRYPTION_KEY=
REALTIME_AGENT_PROVIDER=vertex
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=google/gemini-live-2.5-flash-native-audio
CALLER_AUDIO_GAIN_DB=6
VERTEX_VOICE=Charon
VERTEX_SYSTEM_INSTRUCTION=You are a helpful, concise voice assistant.
GEMINI_RESPONSE_WATCHDOG_SECONDS=3
GEMINI_GENERATION_WATCHDOG_SECONDS=8
GEMINI_RECOVERY_GRACE_SECONDS=6
GEMINI_RECOVERY_READY_TIMEOUT_SECONDS=8
CALLER_INACTIVITY_TIMEOUT_SECONDS=30
CALLER_INACTIVITY_FIRST_TIMEOUT_SECONDS=10
CALLER_INACTIVITY_SECOND_TIMEOUT_SECONDS=10
CALLER_INACTIVITY_FINAL_TIMEOUT_SECONDS=8
# CALLER_INACTIVITY_FIRST_PROMPT="The caller has been silent. Ask briefly and politely if they are still there and can hear you."
# CALLER_INACTIVITY_SECOND_PROMPT="The caller is still silent. Inform them politely that you cannot hear them and will have to end the call if there is no response."
# CALLER_INACTIVITY_GOODBYE_PROMPT="The caller has not responded. Politely say goodbye and thank them for calling."
# Optional localized clip: mono, 24 kHz, 16-bit PCM WAV. Defaults to the bundled English clip.
# GEMINI_FALLBACK_AUDIO_PATH=/opt/chiefvoice/fallback.wav
VERTEX_CREDENTIALS_JSON=
VERTEX_CREDENTIALS_PATH=
VERTEX_PROJECT_ISOLATION_ENABLED=false
GOOGLE_AI_API_KEY=
GOOGLE_AI_LIVE_MODEL=gemini-3.1-flash-live-preview
# When enabled, a dedicated Google Cloud project is created for each tenant.
GCP_PROJECT_PARENT=organizations/123456789012
GCP_BILLING_ACCOUNT_ID=000000-000000-000000
GCP_RUNTIME_SERVICE_ACCOUNT=chiefvoice-runtime@example-project.iam.gserviceaccount.com
GCP_POST_CALL_SERVICE_ACCOUNT=chiefvoice-post-call@example-project.iam.gserviceaccount.com
GCP_BUDGET_API_PROJECT_ID=chiefvoice-billing-ops
GCP_VERTEX_MONTHLY_SPEND_CAP=100
POST_CALL_AGENT_PROVIDER=langchain_vertex
POST_CALL_MODEL=gemini-2.5-flash
POST_CALL_TRANSCRIPTION_PROJECT_ID=
POST_CALL_TRANSCRIPTION_LOCATION=asia-southeast1
POST_CALL_TRANSCRIPTION_MODEL=chirp_2
POST_CALL_ENCRYPTION_KEY=
POST_CALL_EXECUTION_BACKEND=in_process
POST_CALL_LAMBDA_FUNCTION_NAME=
POST_CALL_LAMBDA_REGION=
POST_CALL_GCP_FUNCTION_URL=
POST_CALL_DISPATCH_INTERVAL_SECONDS=1
POST_CALL_REDISPATCH_AFTER_SECONDS=120
VOBIZ_PUBLIC_URL=
VOBIZ_INBOUND_ROUTE_TOKEN=
VOBIZ_WEBHOOK_SECRET=
VOBIZ_ENCODING=audio/x-mulaw
VOBIZ_SAMPLE_RATE=8000
VOBIZ_PLAYBACK_ACK_TIMEOUT_SECONDS=5
VOBIZ_RECORD_INBOUND=false
# Optional platform-managed Vobiz credentials used when adding numbers without customer credentials.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
