# Local Compose only. These values are for development, not production.
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://chiefvoice:local-only-password@db:5432/chiefvoice
CREDENTIALS_ENCRYPTION_KEY=4efjzlkeQDoTeDUJwedX_B-dX-36yXpTkDHOblSKUQ4=

# Disable cloud-only providers so the API and console can run without GCP.
REALTIME_AGENT_PROVIDER=disabled
POST_CALL_AGENT_PROVIDER=disabled
VERTEX_LOCATION=us-central1
# Optional. Required to run Malayalam profiles using Google's Gemini Live API.
GOOGLE_AI_API_KEY=
GOOGLE_AI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Optional Vobiz callback settings. These are not needed to use the console.
VOBIZ_PUBLIC_URL=
VOBIZ_INBOUND_ROUTE_TOKEN=
VOBIZ_WEBHOOK_SECRET=

# Local feature defaults.
RECORDINGS_ENABLED=false
RECORDINGS_STORAGE_BACKEND=local
RETENTION_POLICIES_JSON=[]
BACKUP_POLICIES_JSON=[]
