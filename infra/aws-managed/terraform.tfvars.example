aws_region                  = "us-east-1"
vpc_id                      = "vpc-0123456789abcdef0"
public_subnet_ids           = ["subnet-public-a", "subnet-public-b"]
private_subnet_ids          = ["subnet-private-a", "subnet-private-b"]
certificate_arn             = "arn:aws:acm:us-east-1:123456789012:certificate/example"
api_image_uri               = "123456789012.dkr.ecr.us-east-1.amazonaws.com/chiefvoice-api:release"
post_call_lambda_image_uri  = "123456789012.dkr.ecr.us-east-1.amazonaws.com/chiefvoice-post-call:release"
oidc_issuer                 = "https://identity.example.com/"
oidc_audience               = "chiefvoice-api"
oidc_jwks_url               = "https://identity.example.com/.well-known/jwks.json"
vobiz_public_url            = "https://voice.example.com"
vertex_project_id           = "tenant-vertex-bootstrap-project"
gcp_project_parent          = "folders/123456789012"
gcp_billing_account_id      = "000000-000000-000000"
gcp_runtime_service_account = "chiefvoice-api@host-project.iam.gserviceaccount.com"
gcp_budget_api_project_id   = "host-project"
vertex_credentials_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:chiefvoice/gcp-runtime-credentials"
object_storage_bucket_name  = "replace-with-globally-unique-bucket"
recordings_enabled          = false
