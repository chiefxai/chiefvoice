#!/bin/bash
set -euo pipefail
apt-get update
apt-get install -y docker.io docker-compose-v2
systemctl enable --now docker
mkdir -p /opt/chiefvoice
cat >/opt/chiefvoice/compose.yaml <<'EOF'
services:
  postgres:
    image: postgres:16
    restart: unless-stopped
    environment:
      POSTGRES_DB: ${database_name}
      POSTGRES_USER: ${database_username}
      POSTGRES_PASSWORD: ${database_password}
    ports: ["5432:5432"]
    volumes:
      - postgres_data:/var/lib/postgresql/data
  api:
    image: ${api_image_uri}
    restart: unless-stopped
    depends_on: [postgres]
    ports: ["80:8080"]
    environment:
      DATABASE_URL: postgresql+asyncpg://${database_username}:${database_password}@postgres:5432/${database_name}
      APP_ENV: production
      OBJECT_STORAGE_BUCKET: ${object_bucket}
      OBJECT_STORAGE_REGION: ${aws_region}
      POST_CALL_EXECUTION_BACKEND: sqs
      POST_CALL_SQS_QUEUE_URL: ${queue_url}
volumes:
  postgres_data:
EOF
docker compose -f /opt/chiefvoice/compose.yaml up -d
